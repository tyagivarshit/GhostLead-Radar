# Telegram Bot Token (obtained from @BotFather on Telegram: https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID (message your bot first, then open https://api.telegram.org/bot<TOKEN>/getUpdates to find chat.id)
TELEGRAM_CHAT_ID=

# --- Reddit (OPTIONAL: not used in RSS mode) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 GhostLeadRadar/1.0

# Polling interval in seconds (default: 60, minimum floor: 15 seconds)
POLL_INTERVAL=60

# Optional: SQLite database file path for deduplication (default: seen.db)
SEEN_DB_PATH=seen.db

# Optional: Set to true to alert on existing backlog posts on first run (default: false)
ALERT_ON_FIRST_RUN_BACKLOG=false
